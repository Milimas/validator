{
  "name": "validator",
  "version": "1.0.0",
  "description": "typescript validator library, using validator you can define schemas for building web forms and you can use to validate data ",
  "keywords": [
    "validator",
    "typescript",
    "schema",
    "schemas"
  ],
  "homepage": "https://github.com/DIGI-FUSION/validator#readme",
  "bugs": {
    "url": "https://github.com/DIGI-FUSION/validator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DIGI-FUSION/validator.git"
  },
  "license": "ISC",
  "author": "Millimas",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest --typecheck",
    "build": "tsc --project tsconfig.json",
    "watch": "tsc --watch --project tsconfig.json",
    "dev": "npm run watch",
    "prepare": "npm run build"
  },
  "dependencies": {
    "vitest": "^4.0.15"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "typescript": "^5.9.3"
  }
}
